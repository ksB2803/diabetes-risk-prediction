# Copy to .env and adjust. The run scripts in scripts/*.sh load .env automatically;
# on Windows, set these with `set NAME=value` before running the .bat scripts.
# Every value has a working default, so .env is optional.

# ---------------- Spring Boot backend (backend/) ----------------
SERVER_PORT=8080
# Folder for uploaded CSVs and the H2 database files (relative to backend/)
APP_STORAGE_DIR=./storage
# Keep uploaded CSVs after training (true) or delete them when the job ends (false)
APP_KEEP_UPLOADS=true
# Upload limits
APP_MAX_UPLOAD_SIZE=20MB
APP_MAX_REQUEST_SIZE=21MB
# H2: leave unset for the file-based default. In-memory alternative (lost on restart):
# APP_DB_URL=jdbc:h2:mem:diabetes-risk;DB_CLOSE_DELAY=-1
APP_DB_USER=sa
APP_DB_PASSWORD=
# Training worker pool (bounded)
APP_MAX_CONCURRENT_JOBS=1
APP_JOB_QUEUE_CAPACITY=10
# Extra origins allowed to call /api (comma separated). Empty = same origin only.
APP_CORS_ALLOWED_ORIGINS=

# Where the backend finds the ML service, and timeouts
ML_SERVICE_URL=http://127.0.0.1:8000
ML_CONNECT_TIMEOUT=3s
ML_REQUEST_TIMEOUT=30s
ML_TRAINING_TIMEOUT=10m

# ---------------- Shared secret (set the SAME value for both services) ----------------
# When set, the ML service rejects calls without the X-Internal-Api-Key header.
# Strongly recommended for anything beyond a single local machine.
ML_INTERNAL_API_KEY=

# ---------------- Python ML service (ml-service/) ----------------
ML_PORT=8000
# Folder for trained pipelines (relative to ml-service/)
ML_MODEL_DIR=./storage/models
ML_MAX_UPLOAD_BYTES=20971520
ML_MAX_ROWS=100000
ML_MAX_COLUMNS=100
ML_MIN_ROWS=20
ML_MIN_ROWS_PER_CLASS=5
ML_MAX_CATEGORIES=100
ML_MAX_CONCURRENT_TRAINING=2
# Parallel workers per hyper-parameter search (1 keeps CPU use predictable)
ML_N_JOBS=1
